/* 沿用WindTrace原版设计系统，数值来自theme.py。 */


* {
    font-family: "Microsoft YaHei UI";
    outline: none;
}

QMainWindow,
QWidget#central {
    background-color: {{BG}};
    color: {{TEXT}};
    font-size: {{F9}};
}

QFrame#topBar {
    background-color: {{SURFACE_ALT}};
    border: none;
    border-bottom: 1px solid {{BORDER}};
}

QFrame#bottomBar {
    background-color: {{SURFACE_ALT}};
    border: none;
    border-top: 1px solid {{BORDER}};
}

QWidget#rightPanel,
QWidget#leftView {
    background-color: {{BG}};
}

QFrame#optionsPanel {
    background-color: {{SURFACE}};
    border: none;
    border-right: 1px solid {{BORDER}};
}

QToolButton#collapseButton {
    padding: 0;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    border: none;
    background-color: transparent;
    color: {{SECONDARY}};
    font-size: {{F12}};
}

QToolButton#collapseButton:hover {
    background-color: {{SEGMENT_BG}};
    border-radius: {{R6}};
}

QFrame#separator {
    background-color: {{BORDER}};
    min-width: 1px;
    max-width: 1px;
}

QLabel {
    color: {{TEXT}};
    background-color: transparent;
}

QLabel[muted="true"] {
    color: {{MUTED}};
    font-size: {{F8_5}};
}

QLabel#appName {
    color: {{TEXT}};
    font-size: {{F12}};
    font-weight: 600;
}

QLabel#appVersion,
QLabel#sourceLabel {
    color: {{MUTED}};
    font-size: {{F8_5}};
}

QLabel#groupTitle {
    color: {{GROUP_TITLE}};
    font-size: {{F9_5}};
    font-weight: 600;
}

QLabel#sectionTitle {
    color: {{GROUP_TITLE}};
    font-size: {{F9_5}};
    font-weight: 600;
}

QLabel#curveTitle {
    color: {{TEXT}};
    font-size: {{F10_5}};
    font-weight: 600;
}

QLabel#legendItem {
    color: {{SECONDARY}};
    font-size: {{F8_5}};
}

QLabel#curveHint,
QLabel#axisUnit {
    color: {{MUTED}};
    font-size: {{F8_5}};
}

QLabel#timeLabel {
    color: {{TEXT}};
    font-size: {{F9}};
    font-family: {{MONO}};
}

QLabel#viewOverlay {
    background-color: {{OVERLAY}};
    color: {{TEXT}};
    border: none;
    border-radius: {{R999}};
    padding: 12px;
    font-size: {{F8_5}};
}

QPushButton,
QToolButton {
    min-height: {{CTRL_H}};
    max-height: {{CTRL_H}};
    padding: 0 {{SP12}};
    border: 1px solid {{BORDER}};
    border-radius: {{R6}};
    background-color: {{SURFACE}};
    color: {{TEXT}};
    font-size: {{F9}};
}

QPushButton:hover,
QToolButton:hover {
    background-color: {{SEGMENT_BG}};
}

QPushButton:pressed,
QToolButton:pressed {
    background-color: {{SEGMENT_BG}};
}

QPushButton:disabled,
QToolButton:disabled {
    color: {{MUTED}};
    background-color: {{BG}};
    border-color: {{BORDER}};
}

QPushButton#primary {
    background-color: {{ACCENT}};
    border-color: {{ACCENT}};
    color: {{SURFACE}};
    font-weight: 600;
}

QPushButton#primary:hover,
QPushButton#primary:pressed {
    background-color: {{ACCENT_HOVER}};
    border-color: {{ACCENT_HOVER}};
}

/* 顶栏动作保持安静，主色只留给欢迎页的主按钮。 */
QPushButton#ghostAction {
    background-color: transparent;
    border-color: transparent;
    color: {{SECONDARY}};
}
QPushButton#ghostAction:hover {
    background-color: {{SEGMENT_BG}};
    border-color: {{BORDER}};
    color: {{TEXT}};
}
QPushButton#ghostAction:pressed {
    background-color: {{SELECTION_BG}};
    border-color: {{BORDER}};
}

/* 打开日志卡片使用更舒展的主按钮，不改变其他控件高度。 */
QPushButton[welcomeAction="true"] {
    min-height: 44px;
    max-height: 44px;
    font-size: {{F10_5}};
}

QPushButton#iconButton,
QToolButton#iconButton {
    padding: 0;
    min-width: {{CTRL_H}};
    max-width: {{CTRL_H}};
    font-size: {{F12}};
}

QPushButton[segment="true"] {
    min-height: 30px;
    max-height: 30px;
    padding: 0 {{SP8}};
    font-weight: 400;
    background-color: {{SEGMENT_BG}};
    color: {{SECONDARY}};
    border: 1px solid {{SEGMENT_BORDER}};
}

QPushButton[segment="true"]:hover {
    background-color: {{BORDER}};
    color: {{TEXT}};
}

QPushButton[segment="true"]:checked {
    background-color: {{ACCENT}};
    color: {{SURFACE}};
    border-color: {{ACCENT}};
    font-weight: 600;
}

QPushButton[switch="true"] {
    min-height: 30px;
    max-height: 30px;
    padding: 0 {{SP8}};
    background-color: {{SEGMENT_BG}};
    color: {{SECONDARY}};
    border: 1px solid {{SEGMENT_BORDER}};
}

QPushButton[switch="true"]:checked {
    background-color: {{ACCENT}};
    color: {{SURFACE}};
    border-color: {{ACCENT}};
}

QComboBox {
    min-height: {{CTRL_H}};
    max-height: {{CTRL_H}};
    padding: 0 {{SP4}};
    border: 1px solid {{BORDER}};
    border-radius: {{R6}};
    background-color: {{SURFACE}};
    color: {{TEXT}};
    font-size: {{F9}};
}

QComboBox:hover {
    border-color: {{SEGMENT_BORDER}};
}

QComboBox:focus {
    border-color: {{SECONDARY}};
}

QComboBox::drop-down {
    width: 16px;
    border: none;
    background-color: transparent;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
}

QComboBox QAbstractItemView {
    background-color: {{SURFACE}};
    border: 1px solid {{BORDER}};
    border-radius: {{R6}};
    selection-background-color: {{ACCENT}};
    selection-color: {{SURFACE}};
    padding: {{SP4}};
    outline: none;
}

QSlider::groove:horizontal {
    height: 4px;
    border-radius: {{R2}};
    background-color: {{BORDER}};
}

QSlider::sub-page:horizontal {
    height: 4px;
    border-radius: {{R2}};
    background-color: {{SECONDARY}};
}

QSlider::add-page:horizontal {
    height: 4px;
    border-radius: {{R2}};
    background-color: {{BORDER}};
}

QSlider::handle:horizontal {
    width: 12px;
    height: 12px;
    margin: -4px 0;
    border-radius: {{R6H}};
    border: 2px solid {{SECONDARY}};
    background-color: {{SURFACE}};
}

QSlider::handle:horizontal:hover {
    background-color: {{SEGMENT_BG}};
}

QFrame#chartCard {
    background-color: {{SURFACE}};
    border: 1px solid {{BORDER}};
    border-radius: {{R8}};
}

QSplitter::handle {
    background-color: {{BORDER}};
}

QSplitter::handle:horizontal {
    width: {{SP8}};
}

QSplitter::handle:vertical {
    height: {{SP8}};
}

QSplitter::handle:hover {
    background-color: {{MUTED}};
}

QStatusBar {
    background-color: {{SURFACE_ALT}};
    border-top: 1px solid {{BORDER}};
    color: {{MUTED}};
    font-size: {{F8_5}};
}

QStatusBar::item {
    border: none;
}

QToolTip {
    background-color: {{SURFACE}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
    padding: {{SP4}} {{SP8}};
    font-size: {{F8_5}};
}

QMenu {
    background-color: {{SURFACE}};
    border: 1px solid {{BORDER}};
    padding: {{SP4}};
}

QMenu::item {
    padding: {{SP4}} {{SP16}};
    border-radius: {{R6}};
    color: {{TEXT}};
}

QMenu::item:selected {
    background-color: {{ACCENT}};
    color: {{SURFACE}};
}


QFrame#leftRail {
    background-color: {{SURFACE}};
    border-right: 1px solid {{BORDER}};
}

QToolButton#railButton {
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    padding: 0;
    border: none;
    border-radius: {{R6}};
    background: transparent;
    color: {{SECONDARY}};
    font-size: {{F12}};
}
QToolButton#railButton:hover { background-color: {{SEGMENT_BG}}; }
QToolButton#railButton[active="true"] { background-color: {{SEGMENT_BG}}; color: {{ACCENT}}; }

QFrame#leftDrawer {
    background-color: {{SURFACE}};
    border: 1px solid {{BORDER}};
    border-radius: {{R8}};
}

QWidget#viewHolder { background-color: {{BG}}; }

QFrame#curveDrawer {
    background-color: {{SURFACE}};
    border-top: 1px solid {{BORDER}};
}
QFrame#curveGrip { background-color: {{BORDER}}; }
QFrame#curveGrip:hover { background-color: {{MUTED}}; }

QToolButton#drawerClose {
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    padding: 0;
    border: none;
    background: transparent;
    color: {{SECONDARY}};
    font-size: {{F12}};
}
QToolButton#drawerClose:hover { background-color: {{SEGMENT_BG}}; border-radius: {{R6}}; }

QToolButton#accordionHeader {
    padding: 0 {{SP8}};
    border: none;
    background: transparent;
    color: {{TEXT}};
    font-weight: 600;
    text-align: left;
}
QToolButton#accordionHeader:hover { background-color: {{SEGMENT_BG}}; border-radius: {{R6}}; }

QToolButton#crumb {
    padding: 0 2px;
    min-height: 24px;
    max-height: 24px;
    border: none;
    background: transparent;
    color: {{TEXT}};
    font-size: {{F9}};
}
QToolButton#crumb:hover { background-color: {{SEGMENT_BG}}; border-radius: {{R6}}; }
QLabel#crumbSep { color: {{MUTED}}; font-size: {{F9}}; }

QToolButton#helpButton {
    min-height: 30px;
    max-height: 30px;
    padding: 0 {{SP8}};
    border: none;
    background: transparent;
    color: {{MUTED}};
    font-size: {{F8_5}};
}
QToolButton#helpButton:hover { background-color: {{SEGMENT_BG}}; border-radius: {{R6}}; }
QPushButton#curveToggle { min-height: 30px; max-height: 30px; padding: 0 {{SP8}}; }
QLabel#infoValue { color: {{TEXT}}; font-size: {{F8_5}}; }
QLabel#aboutTitle { color: {{TEXT}}; font-size: {{F12}}; font-weight: 600; }
QLabel#aboutNote { color: {{DANGER}}; font-size: {{F8_5}}; }

/* v1.0：补齐原版未覆盖的控件状态，避免白底白框与不可见选中。 */
QLabel[hint="true"] { color: {{MUTED}}; font-size: {{F8_5}}; }
QLabel[warn="true"] { color: {{DANGER}}; font-size: {{F8_5}}; }

QCheckBox {
    color: {{TEXT}};
    spacing: 8px;
    min-height: 24px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid {{BORDER_STRONG}};
    border-radius: {{R2}};
    background-color: {{SURFACE}};
}
QCheckBox::indicator:hover { border-color: {{ACCENT}}; }
QCheckBox::indicator:checked {
    background-color: {{ACCENT}};
    border-color: {{ACCENT}};
    image: url({{CHECK_ICON}});
}
QCheckBox::indicator:disabled { background-color: {{BG}}; border-color: {{BORDER}}; }

QLineEdit, QPlainTextEdit, QTextEdit {
    border: 1px solid {{BORDER_STRONG}};
    border-radius: {{R6}};
    background-color: {{SURFACE}};
    color: {{TEXT}};
    selection-background-color: {{ACCENT}};
    selection-color: {{SURFACE}};
    font-size: {{F9}};
}
QLineEdit { min-height: {{CTRL_H}}; max-height: {{CTRL_H}}; padding: 0 {{SP8}}; }
QPlainTextEdit, QTextEdit { padding: {{SP8}}; }
QLineEdit:hover, QPlainTextEdit:hover, QTextEdit:hover { border-color: {{MUTED}}; }
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus { border-color: {{ACCENT}}; }

QTableWidget, QTableView {
    border: 1px solid {{BORDER}};
    border-radius: {{R6}};
    background-color: {{SURFACE}};
    alternate-background-color: {{SURFACE_ALT}};
    gridline-color: {{BORDER}};
    selection-background-color: {{SELECTION_BG}};
    selection-color: {{TEXT}};
}
QHeaderView::section {
    background-color: {{SURFACE_ALT}};
    color: {{SECONDARY}};
    border: none;
    border-right: 1px solid {{BORDER}};
    border-bottom: 1px solid {{BORDER}};
    padding: {{SP4}} {{SP8}};
    font-weight: 600;
    font-size: {{F8_5}};
}
QTableCornerButton::section { background-color: {{SURFACE_ALT}}; border: none; }

QListWidget {
    border: 1px solid {{BORDER}};
    border-radius: {{R6}};
    background-color: {{SURFACE}};
    outline: none;
}
QListWidget::item { border-bottom: 1px solid {{BORDER}}; padding: {{SP4}} {{SP8}}; }
QListWidget::item:hover { background-color: {{SURFACE_ALT}}; }
QListWidget::item:selected { background-color: {{SELECTION_BG}}; color: {{TEXT}}; }

QComboBox QAbstractItemView::item { padding: {{SP4}} {{SP8}}; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: {{SEGMENT_BORDER}}; border-radius: 5px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: {{MUTED}}; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: {{SEGMENT_BORDER}}; border-radius: 5px; min-width: 24px; }
QScrollBar::handle:horizontal:hover { background: {{MUTED}}; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }
